{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",
      "Bash(make *)",
      "Bash(ruff *)",
      "Bash(ssh adminvps *)",
      "Bash(docker compose *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(tree *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/data/*.db)",
      "Read(**/data/*.db-*)",
      "Read(**/static/uploads/**)",
      "Read(**/data/exports/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/projects/pravoagent",
        "/tmp/pravoagent"
      ]
    }
  }
}
