# ПравоАгент - пример переменных окружения.
# Скопируй в .env и заполни. .env НИКОГДА не коммитить (в .gitignore).

# App
APP_NAME="ПравоАгент"
APP_VERSION="0.2.0"
DEBUG=true
SECRET_KEY=change-me-to-random-string            # ОБЯЗАТЕЛЬНО сменить
DATABASE_URL=sqlite:///./data/pravoagent.db

# Demo mode (true = mock-ответы LLM, без реальных вызовов)
DEMO_MODE=true

# JWT
JWT_SECRET_KEY=change-me-to-random-string        # ОБЯЗАТЕЛЬНО сменить
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model router
DEFAULT_MODEL_TIER=flash                         # flash | balance | pro
MAX_TOKENS_PER_MONTH=10000000

# LLM keys (заполни при переходе из DEMO_MODE)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OLLAMA_ENDPOINT=http://localhost:11434

# Qdrant
QDRANT_HOST=qdrant                               # localhost при локальном запуске без docker
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://redis:6379/0                   # redis://localhost:6379/0 локально

# Storage
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
